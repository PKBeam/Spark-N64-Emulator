    OP_DADD    = 0b101100,
    OP_DADDU   = 0b101101,
    OP_DSUB    = 0b101110,
    OP_DSUBU   = 0b101111,
    OP_TGE     = 0b110000,
    OP_TGEU    = 0b110001,
    OP_TLT     = 0b110010,
    OP_TLTU    = 0b110011,
    OP_TEQ     = 0b110100,
    OP_TNE     = 0b110110,
    OP_DSLL    = 0b111000,
    OP_DSRL    = 0b111010,
    OP_DSRA    = 0b111011,
    OP_DSLL32  = 0b111100,
