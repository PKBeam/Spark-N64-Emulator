    OP_JALR    = 0b001001,
    OP_SYSCALL = 0b001100,
    OP_BREAK   = 0b001101,
    OP_SYNC    = 0b001111,
    OP_MFHI    = 0b010000,
    OP_MTHI    = 0b010001,
    OP_MFLO    = 0b010010,
    OP_MTLO    = 0b010011,
    OP_DSLLV   = 0b010100,
    OP_DSRLV   = 0b010110,
    OP_DSRAV   = 0b010111,
    OP_MULT    = 0b011000,
    OP_MULTU   = 0b011001,
    OP_DIV     = 0b011010,
    OP_DIVU    = 0b011011,
    OP_DMULT   = 0b011100,
    OP_DMULTU  = 0b011101,
    OP_DDIV    = 0b011110,
    OP_DDIVU   = 0b011111,
    OP_ADD     = 0b100000,
    OP_ADDU    = 0b100001,
    OP_SUB     = 0b100010,
    OP_SUBU    = 0b100011,
    OP_AND     = 0b100100,
