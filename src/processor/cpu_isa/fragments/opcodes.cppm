struct UnifiedOpcodeBase {
    enum : uint32_t {
        INVALID          = 0,
        OPCODE_BASE      = 0x100,
        SPECIAL_BASE     = 0x200,
        REGIMM_rt_BASE   = 0x300,
        COPz_rs_BASE     = 0x400,
        COPz_rt_BASE     = 0x500,
        CP0_BASE         = 0x600,
        COP2_LOAD_BASE   = 0x700,
        COP2_STORE_BASE  = 0x800,
        COP2_SCALAR_BASE = 0x900,
        COP2_VECTOR_BASE = 0xA00,
    };
};

enum class UnifiedOpcode : uint32_t {
    // clang-format off
        OP_UNKNOWN = static_cast<uint32_t>(UnifiedOpcodeBase::INVALID),
        OP_NOP,
        OP_COPz,
        // Standard opcodes
