enum class REGIMM_rt : uint8_t {
    OP_BLTZ    = 0b000000,
    OP_BGEZ    = 0b000001,
    OP_BLTZL   = 0b000010,
    OP_BGEZL   = 0b000011,
    OP_TGEI    = 0b001000,
    OP_TGEIU   = 0b001001,
    OP_TLTI    = 0b001010,
    OP_TLTIU   = 0b001011,
    OP_TEQI    = 0b001100,
    OP_TNEI    = 0b001110,
    OP_BLTZAL  = 0b010000,
    OP_BGEZAL  = 0b010001,
    OP_BLTZALL = 0b010010,
    OP_BGEZALL = 0b010011,
};

// two high bits = 'z' (coprocessor number)
enum class COPz_rs : uint8_t {
    OP_MFCz  = 0b00000,
    OP_DMFCz = 0b00001,
    OP_CFCz  = 0b00010,
    OP_MTCz  = 0b00100,
    OP_DMTCz = 0b00101,
    OP_CTCz  = 0b00110,
    OP_BC    = 0b01000,
    // OP_COPz = 0b1xxxx, handled specially
};

enum class COPz_rt : uint8_t {
    OP_BCzF  = 0b00000,
    OP_BCzT  = 0b00001,
    OP_BCzFL = 0b00010,
    OP_BCzTL = 0b00100,
};

enum class CP0 : uint8_t {
    OP_TLBR  = 0b000001,
    OP_TLBWI = 0b000010,
    OP_TLBWR = 0b000110,
    OP_TLBP  = 0b001000,
    OP_ERET  = 0b011000,
};

enum class COP2_LOAD : uint8_t {
    OP_LBV = 0b0000,
    OP_LSV = 0b0001,
    OP_LLV = 0b0010,
    OP_LDV = 0b0011,
    OP_LQV = 0b0100,
    OP_LRV = 0b0101,
