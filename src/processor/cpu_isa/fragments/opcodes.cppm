    OP_VSUM         = 0b011100,
    OP_VSAW         = 0b011101,
    OP_RESERVED_V0  = 0b011110,
    OP_RESERVED_V1  = 0b011111,
    OP_VLT          = 0b100000,
    OP_VEQ          = 0b100001,
    OP_VNE          = 0b100010,
    OP_VGE          = 0b100011,
    OP_VCL          = 0b100100,
    OP_VCH          = 0b100101,
    OP_VCR          = 0b100110,
    OP_VMRG         = 0b100111,
    OP_VAND         = 0b101000,
