        OP_RESERVED_SPECIAL_40,
        OP_RESERVED_SPECIAL_41,
        OP_SLT      [[=^^ISA::OpType::CPU_Bivariate]],
        OP_SLTU     [[=^^ISA::OpType::CPU_Bivariate]],
