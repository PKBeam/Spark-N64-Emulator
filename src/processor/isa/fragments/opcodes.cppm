struct UnifiedOpcodeBase {
    enum : uint32_t {
        INVALID          = 0,
        OPCODE_BASE      = 0x100,
        SPECIAL_BASE     = 0x200,
        REGIMM_rt_BASE   = 0x300,
        COPz_rs_BASE     = 0x400,
        COPz_rt_BASE     = 0x500,
        CP0_BASE         = 0x600,
        CP1_BASE         = 0x700,
        COP2_LOAD_BASE   = 0x800,
        COP2_STORE_BASE  = 0x900,
        COP2_SCALAR_BASE = 0xA00,
        CP2_BASE         = 0xB00,
    };
};

enum class UnifiedOpcode : uint32_t {
    // clang-format off
        OP_UNKNOWN = static_cast<uint32_t>(UnifiedOpcodeBase::INVALID),
        OP_NOP,
        OP_COPz,
        // Standard opcodes
        OP_SPECIAL = static_cast<uint32_t>(UnifiedOpcodeBase::OPCODE_BASE),
        OP_REGIMM,
        OP_J        [[=^^ISA::OpType::CPU_Jump]],
        OP_JAL      [[=^^ISA::OpType::CPU_Jump]],
        OP_BEQ      [[=^^ISA::OpType::CPU_Branch2]],
        OP_BNE      [[=^^ISA::OpType::CPU_Branch2]],
        OP_BLEZ     [[=^^ISA::OpType::CPU_Branch1]],
        OP_BGTZ     [[=^^ISA::OpType::CPU_Branch1]],
        OP_ADDI     [[=^^ISA::OpType::CPU_AluImm]],
        OP_ADDIU    [[=^^ISA::OpType::CPU_AluImm]],
        OP_SLTI     [[=^^ISA::OpType::CPU_AluImm]],
        OP_SLTIU    [[=^^ISA::OpType::CPU_AluImm]],
        OP_ANDI     [[=^^ISA::OpType::CPU_AluImm]],
        OP_ORI      [[=^^ISA::OpType::CPU_AluImm]],
        OP_XORI     [[=^^ISA::OpType::CPU_AluImm]],
        OP_LUI      [[=^^ISA::OpType::CPU_AluImmLoad]],
        OP_COP0,
        OP_COP1,
        OP_COP2,
        OP_RESERVED_OPCODE_19,
        OP_BEQL     [[=^^ISA::OpType::CPU_Branch2]],
        OP_BNEL     [[=^^ISA::OpType::CPU_Branch2]],
        OP_BLEZL    [[=^^ISA::OpType::CPU_Branch2]],
        OP_BGTZL    [[=^^ISA::OpType::CPU_Branch2]],
        OP_DADDI    [[=^^ISA::OpType::CPU_AluImm]],
        OP_DADDIU   [[=^^ISA::OpType::CPU_AluImm]],
        OP_LDL      [[=^^ISA::OpType::CPU_LoadStore]],
        OP_LDR      [[=^^ISA::OpType::CPU_LoadStore]],
        OP_RESERVED_OPCODE_28,
        OP_RESERVED_OPCODE_29,
        OP_RESERVED_OPCODE_30,
        OP_RESERVED_OPCODE_31,
        OP_LB       [[=^^ISA::OpType::CPU_LoadStore]],
        OP_LH       [[=^^ISA::OpType::CPU_LoadStore]],
        OP_LWL      [[=^^ISA::OpType::CPU_LoadStore]],
        OP_LW       [[=^^ISA::OpType::CPU_LoadStore]],
        OP_LBU      [[=^^ISA::OpType::CPU_LoadStore]],
        OP_LHU      [[=^^ISA::OpType::CPU_LoadStore]],
        OP_LWR      [[=^^ISA::OpType::CPU_LoadStore]],
        OP_LWU      [[=^^ISA::OpType::CPU_LoadStore]],
        OP_SB       [[=^^ISA::OpType::CPU_LoadStore]],
        OP_SH       [[=^^ISA::OpType::CPU_LoadStore]],
        OP_SWL      [[=^^ISA::OpType::CPU_LoadStore]],
        OP_SW       [[=^^ISA::OpType::CPU_LoadStore]],
        OP_SDL      [[=^^ISA::OpType::CPU_LoadStore]],
        OP_SDR      [[=^^ISA::OpType::CPU_LoadStore]],
        OP_SWR      [[=^^ISA::OpType::CPU_LoadStore]],
        OP_CACHE    [[=^^ISA::OpType::CPU_LoadStore]],
        OP_LL       [[=^^ISA::OpType::CPU_LoadStore]],
        OP_LWC1     [[=^^ISA::OpType::CP1_LoadStore]],   
        OP_LWC2,
        OP_RESERVED_OPCODE_50,
        OP_LLD      [[=^^ISA::OpType::CPU_LoadStore]],
        OP_LDC1     [[=^^ISA::OpType::CP1_LoadStore]],
        OP_LDC2,
        OP_LD       [[=^^ISA::OpType::CPU_LoadStore]],
        OP_SC       [[=^^ISA::OpType::CPU_LoadStore]],
        OP_SWC1     [[=^^ISA::OpType::CP1_LoadStore]],
        OP_SWC2,
        OP_RESERVED_OPCODE_59,
        OP_SCD      [[=^^ISA::OpType::CPU_LoadStore]],
        OP_SDC1     [[=^^ISA::OpType::CP1_LoadStore]],
        OP_SDC2,
        OP_SD       [[=^^ISA::OpType::CPU_LoadStore]],
        // SPECIAL opcodes
        OP_SLL      [[=^^ISA::OpType::CPU_Shift]] = static_cast<uint32_t>(UnifiedOpcodeBase::SPECIAL_BASE),
        OP_RESERVED_SPECIAL_1,
        OP_SRL      [[=^^ISA::OpType::CPU_Shift]],
        OP_SRA      [[=^^ISA::OpType::CPU_Shift]],
        OP_SLLV     [[=^^ISA::OpType::CPU_ShiftVar]],
        OP_RESERVED_SPECIAL_5,
        OP_SRLV     [[=^^ISA::OpType::CPU_ShiftVar]],
        OP_SRAV     [[=^^ISA::OpType::CPU_ShiftVar]],
        OP_JR       [[=^^ISA::OpType::CPU_JumpReg]],
