    OP_MTCz       = 0b00100,
    OP_DMTCz      = 0b00101,
    OP_CTCz       = 0b00110,
    OP_RESERVED_7 = 0b00111,
    OP_BC         = 0b01000,
    // OP_COPz = 0b1xxxx, handled specially
};

