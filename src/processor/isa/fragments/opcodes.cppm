        OP_MTLO     [[=^^ISA::OpType::CPU_MoveTo]],
        OP_DSLLV    [[=^^ISA::OpType::CPU_ShiftVar]],
        OP_RESERVED_SPECIAL_21,
        OP_DSRLV    [[=^^ISA::OpType::CPU_ShiftVar]],
        OP_DSRAV    [[=^^ISA::OpType::CPU_ShiftVar]],
        OP_MULT     [[=^^ISA::OpType::CPU_MulDiv]],
        OP_MULTU    [[=^^ISA::OpType::CPU_MulDiv]],
        OP_DIV      [[=^^ISA::OpType::CPU_MulDiv]],
        OP_DIVU     [[=^^ISA::OpType::CPU_MulDiv]],
        OP_DMULT    [[=^^ISA::OpType::CPU_MulDiv]],
        OP_DMULTU   [[=^^ISA::OpType::CPU_MulDiv]],
        OP_DDIV     [[=^^ISA::OpType::CPU_MulDiv]],
        OP_DDIVU    [[=^^ISA::OpType::CPU_MulDiv]],
        OP_ADD      [[=^^ISA::OpType::CPU_Bivariate]],
        OP_ADDU     [[=^^ISA::OpType::CPU_Bivariate]],
        OP_SUB      [[=^^ISA::OpType::CPU_Bivariate]],
        OP_SUBU     [[=^^ISA::OpType::CPU_Bivariate]],
