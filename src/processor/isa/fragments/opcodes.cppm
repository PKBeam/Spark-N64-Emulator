    OP_ANDI        = 0b001100,
    OP_ORI         = 0b001101,
    OP_XORI        = 0b001110,
    OP_LUI         = 0b001111,
    OP_COP0        = 0b010000,
    OP_COP1        = 0b010001,
    OP_COP2        = 0b010010,
    OP_RESERVED_19 = 0b010011,
    OP_BEQL        = 0b010100,
    OP_BNEL        = 0b010101,
    OP_BLEZL       = 0b010110,
    OP_BGTZL       = 0b010111,
    OP_DADDI       = 0b011000,
    OP_DADDIU      = 0b011001,
    OP_LDL         = 0b011010,
    OP_LDR         = 0b011011,
    OP_RESERVED_28 = 0b011100,
    OP_RESERVED_29 = 0b011101,
    OP_RESERVED_30 = 0b011110,
    OP_RESERVED_31 = 0b011111,
    OP_LB          = 0b100000,
    OP_LH          = 0b100001,
    OP_LWL         = 0b100010,
    OP_LW          = 0b100011,
    OP_LBU         = 0b100100,
    OP_LHU         = 0b100101,
    OP_LWR         = 0b100110,
    OP_LWU         = 0b100111,
    OP_SB          = 0b101000,
    OP_SH          = 0b101001,
    OP_SWL         = 0b101010,
    OP_SW          = 0b101011,
    OP_SDL         = 0b101100,
    OP_SDR         = 0b101101,
    OP_SWR         = 0b101110,
    OP_CACHE       = 0b101111,
    OP_LL          = 0b110000,
    OP_LWC1        = 0b110001,
    OP_LWC2        = 0b110010,
    OP_RESERVED_50 = 0b110011,
    OP_LLD         = 0b110100,
    OP_LDC1        = 0b110101,
